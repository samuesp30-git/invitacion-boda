{
 "rewrites": [
  {
   "source": "/(.*)",
   "destination": "/index.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/cancion.mp3",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}